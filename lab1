    <!-- небольшой скрипт для добавления анимаций плавного появления при скролле (опционально) -->
    <script>
        // Функция для анимации элементов при скролле (Intersection Observer)
        const animatedElements = document.querySelectorAll('.animate-on-load');
        
        // Удаляем класс animate-on-load, чтобы он не мешал, но сохраняем прозрачность?
        // Мы используем его при загрузке. Для скролла добавим наблюдатель.
        window.addEventListener('load', function() {
            // Дополнительно: наблюдатель, если захотим повторную анимацию
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.style.animation = 'fadeSlideUp 0.8s ease forwards';
                    }
                });
            }, { threshold: 0.2 });
            
            document.querySelectorAll('.feature-card, .agent-item, .news-item, .arsenal, .section-title').forEach(el => {
                observer.observe(el);
            });
        });
    </script>
